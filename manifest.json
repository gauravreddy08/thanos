{
  "manifest_version": 3,
  "name": "Jev Lens",
  "version": "0.1.0",
  "description": "Ask a page a question out loud. Everything that doesn't answer it fades away.",
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-lens": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Ask the page a question"
    }
  }
}
